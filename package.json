{
    "name": "Phlox",
    "version": "2.2.4",
    "private": true,
    "engines": {
        "node": ">=24 <25",
        "npm": ">=11.12.1"
    },
    "packageManager": "npm@11.16.0",
    "dependencies": {
        "@chakra-ui/react": "3.36.1",
        "@emotion/react": "11.14.0",
        "@fontsource/space-grotesk": "5.3.0",
        "@tauri-apps/api": "2.11.1",
        "@tauri-apps/plugin-http": "2.5.9",
        "next-themes": "0.4.6",
        "pdf-lib": "1.17.1",
        "pdfjs-dist": "6.2.108",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "react-icons": "5.7.0",
        "react-markdown": "10.1.0",
        "react-router": "8.3.0",
        "react-textarea-autosize": "8.5.9",
        "remark-gfm": "4.0.1",
        "swr": "2.5.1"
    },
    "scripts": {
        "start-react": "vite",
        "dev": "concurrently --kill-others-on-fail -n web,api -c cyan,green \"npm run start-react\" \"DB_ENCRYPTION_KEY=${DB_ENCRYPTION_KEY:-phlox-dev-insecure-key} PHLOX_DEV_BOOT=1 server/.venv/bin/python -m uvicorn server.server:app --reload --host 127.0.0.1 --port 5000\"",
        "build": "vite build",
        "typecheck": "tsc --noEmit",
        "lint": "eslint .",
        "lint:fast": "oxlint",
        "lint:fix": "eslint . --fix",
        "build-server": "bash src-tauri/build-server.sh",
        "test": "vitest",
        "tauri": "tauri",
        "tauri-dev": "bash -c 'source src-tauri/dev-env.sh; bash build-all.sh --debug --skip-cpp && tauri dev'",
        "tauri-build": "bash build-all.sh && tauri build"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "description": "Open-source patient management with AI-powered transcription and clinical notes.",
    "main": "index.js",
    "keywords": [],
    "author": "",
    "license": "MIT",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tauri-apps/cli": "^2.11.4",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^26.3.0",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.5",
        "@vitejs/plugin-react": "^6.1.0",
        "concurrently": "^10.0.5",
        "eslint": "^10.9.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-unused-imports": "^4.4.1",
        "globals": "^17.11.0",
        "jsdom": "^29.1.1",
        "oxlint": "^1.80.0",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.68.0",
        "vite": "^8.1.5",
        "vite-plugin-static-copy": "^4.1.1",
        "vitest": "^4.1.11"
    }
}
