# syntax=docker/dockerfile:1
#
# Phlox - development image (Vite dev server + uvicorn --reload, hot reload via
# bind mounts).
#
# Build:  docker build -f Dockerfile.dev -t localhost/phlox-dev:latest .
# Run:    docker compose -f docker-compose.dev.yml up
#         UI:  http://localhost:3000  (Vite proxies /api to :5000)
#         API: http://localhost:5000/docs
#
# After changing package.json/package-lock.json or server/uv.lock, rebuild the
# image and reset the dependency volumes:
#   docker compose -f docker-compose.dev.yml build
#   docker compose -f docker-compose.dev.yml down -v
#
# BuildKit cache mounts keep npm/apt/uv download caches warm across rebuilds;
# they never end up in the shipped image.

###############################################################################
# Stage 1 - Node.js toolchain and node_modules
###############################################################################
FROM node:24-slim AS node-stage

WORKDIR /usr/src/app

# Lockfile-driven install (reproducible); .npmrc pins ignore-scripts and the
# min-release-age cooldown. The BuildKit cache mount keeps downloaded tarballs
# warm across rebuilds; node_modules is committed to the stage layer.
COPY package.json package-lock.json .npmrc .nvmrc ./
RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    npm ci --ignore-scripts --no-audit --no-fund

###############################################################################
# Stage 2 - Python + Node runtime
###############################################################################
FROM python:3.12-slim

# uv version must match [tool.uv].required-version in server/pyproject.toml.
COPY --from=ghcr.io/astral-sh/uv:0.11.32@sha256:df4cae8f3a96d175e2e5f992e597550000edbe78fdc2594d5cd8de1a217f504c /uv /usr/local/bin/uv

WORKDIR /usr/src/app

# DOCKER_CONTAINER selects the Docker code path (server/constants.py) so the
# server does not wait for a desktop passphrase; PATH picks up the uv-locked
# venv; RATE_LIMIT_ENABLED is off for dev; UV_PYTHON_* keep uv from downloading a
# second CPython during the image build.
ENV DOCKER_CONTAINER=true \
    NODE_ENV=development \
    PATH=/usr/src/app/server/.venv/bin:$PATH \
    PYTHONPATH=/usr/src/app \
    PYTHONUNBUFFERED=1 \
    SERVER_HOST=0.0.0.0 \
    PORT=5000 \
    RATE_LIMIT_ENABLED=false \
    UV_PYTHON_PREFERENCE=only-system \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    TIKTOKEN_CACHE_DIR=/usr/src/app/.cache/tiktoken

# parallel  - runs Vite and uvicorn side by side in one container
# tesseract - OCR used by document processing
# tzdata    - makes the TZ environment variable resolve to a real zone
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        parallel \
        tesseract-ocr \
        tesseract-ocr-eng \
        tzdata \
    && rm -rf /var/lib/apt/lists/*

# Node.js + npm from the node stage (keeps the slim Python base image small).
COPY --from=node-stage /usr/local/bin/node /usr/local/bin/node
COPY --from=node-stage /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -sf /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

# node_modules (the dev bind mount hides it, so it is preserved in a volume).
COPY --from=node-stage /usr/src/app/node_modules ./node_modules

# Dependency manifests first to keep the uv layer cached.
COPY server/pyproject.toml server/uv.lock server/.python-version ./server/

# Writable dirs; `build` only has to exist so StaticFiles() can mount it when the
# server is run without Vite.
RUN mkdir -p /usr/src/app/data /usr/src/app/temp /usr/src/app/build \
             /usr/src/app/.cache/tiktoken \
    && printf '<html><body>run the Vite dev server on :3000</body></html>\n' \
       > /usr/src/app/build/index.html

# Python dependencies - dev group included so pytest/ruff/ty work in-container.
# The BuildKit cache mount keeps downloaded wheels warm across rebuilds.
RUN --mount=type=cache,target=/root/.cache/uv,sharing=locked \
    uv sync --directory server --locked --extra docker

# Pre-cache the tokenizer data used by RAG chunking.
RUN python -c "import tiktoken; tiktoken.get_encoding('cl100k_base')"

# Server code (bind-mounted over at runtime, baked in so the image can also be
# run standalone).
COPY server/ ./server/

# Frontend sources, baked in so the image can also run standalone; the
# docker-compose.dev.yml bind mount overrides them for hot reload.
COPY package.json package-lock.json .npmrc .nvmrc CHANGELOG.md ./
COPY index.html vite.config.js tsconfig.json eslint.config.js ./
COPY src/ ./src/
COPY public/ ./public/

# Dev entrypoint: seed demo data on a fresh database only - demo_db.py wipes
# encounters/profiles/templates, so it must never run against an existing DB.
RUN printf '%s\n' \
'#!/usr/bin/env bash' \
'set -euo pipefail' \
'' \
'cd /usr/src/app' \
'' \
'if [ ! -f "data/phlox_database.sqlite" ] && [ ! -f "data/phlox_database.sqlite.wal" ]; then' \
'    python /usr/src/app/server/demo/demo_db.py || echo "WARN: demo seeding skipped"' \
'else' \
'    echo "Existing dev database found - keeping it (rm -rf data/ to re-seed)"' \
'fi' \
'' \
'export SERVER_HOST="${SERVER_HOST:-0.0.0.0}"' \
'export PORT="${PORT:-5000}"' \
'' \
'# --reload-dir keeps uvicorn from restarting on every frontend/node_modules write.' \
'exec parallel --tag --line-buffer --jobs 2 ::: "npm run start-react" "uvicorn server.server:app --reload --reload-dir /usr/src/app/server --host ${SERVER_HOST} --port ${PORT}"' \
> /usr/local/bin/start-phlox-dev.sh \
    && chmod +x /usr/local/bin/start-phlox-dev.sh

EXPOSE 3000 5000

CMD ["/usr/local/bin/start-phlox-dev.sh"]
