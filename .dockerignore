# Version control
.git/
.gitignore

# Local secrets and environment files - never bake them into an image
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# CI / IDE / tooling
.github/
.vscode/
.idea/
.zed/
.flatpak-builder/
build-dir/
opencode.*
AGENTS.md
CLAUDE.md

# Build artifacts and logs
build.log
build/
dist/
.tmp/
coverage/
coverage.*
.coverage
.coveralls.yml
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Tauri / desktop packaging artifacts (not needed by the web or server build)
src-tauri/
assets/
packaging/
build-all.sh

# Node
node_modules/
**/node_modules/
package-lock.old

# Python caches and venvs
.venv/
**/.venv/
server/.venv/
server/.pytest_cache/
server/.ruff_cache/
server/dist/
server/phlox_server.egg-info/
**/*.egg-info/
**/__pycache__
**/*.pyc
**/*.pyo
**/*.pyd

# Documentation
/docs/

# Persistent data
data/
logs/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.log
server/logs/
